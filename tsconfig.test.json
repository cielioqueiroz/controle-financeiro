{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    // vite/client entra aqui porque um teste que renderiza o App puxa junto
    // a cadeia até domain/pdf/load.ts, que importa o worker do pdf.js com
    // sufixo ?url. Quem declara esse formato de import é o vite/client; sem
    // ele o tsc reprova um arquivo que o app compila sem problema.
    "types": ["node", "vitest/globals", "vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "scripts", "index.test.ts"]
}
