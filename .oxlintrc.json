{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true,
        "allowExportNames": [
          "useT",
          "useDados",
          "useTravarRolagem",
          "useDiscreto",
          "useImportacao",
          "useImportacaoOpcional",
          "useDinheiro"
        ]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/persist/*"],
            "message": "persist/ é o adaptador do Neon. A tela conhece a interface de consulta, não o adaptador: importe de aplicacao/consultas ou aplicacao/comandos. Ver docs/adr/0010 e 0013."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "frontend/src/aplicacao/**",
        "frontend/src/persist/**",
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
