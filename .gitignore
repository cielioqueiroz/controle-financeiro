# Dependências (caso adicione tooling depois)
node_modules/
.pnp/
.pnp.js

# Builds / saída
dist/
build/
out/
.cache/
.parcel-cache/
.vite/

# Variáveis de ambiente / segredos
.env
.env.*
!.env.example
# Valores de teste, sem segredo e sem destino real. Versionado de propósito:
# sem ele, cinco testes só passam na máquina de quem tem o `.env.local`.
!.env.test
# Os dois endereços de localhost do `medir-login.py` e o modo "importa e vê",
# que é vazio por definição. Mesmo motivo: sem segredo e sem destino real, e
# versionar é o que faz o medidor medir a mesma coisa em toda máquina.
!.env.login
!.env.semlogin

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Arquivos do sistema operacional
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editores / IDEs
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json

# Documentos financeiros reais (CPF, agência, conta, nomes de terceiros).
# Nunca commitar: o histórico do git é permanente.
# Fixtures de teste ficam em tests/fixtures/, anonimizados.
*.pdf
# A exceção precisa do caminho REAL: os fixtures moram em
# `frontend/tests/fixtures/`, e `tests/fixtures/**` (com barra no meio) é
# ancorado na raiz — nunca alcançou nada. Conferido com `git check-ignore -v`.
!frontend/tests/fixtures/**/*.pdf
documentos/
extratos/

# Ferramenta de diagnóstico local (usa caminhos de PDFs reais)
scripts/diagnostico.ts
scripts/_*.ts

# Config local de ferramenta (o .claude/ ja fica de fora pelo ignore global).
# Nao e do projeto: cada maquina tem a sua.
.codex/

# Bytecode do Python. Nasce sozinho quando um medidor importa outro como
# modulo (o medir-a11y faz isso com o medir-overflow), e um .pyc chegou a ser
# commitado assim em 2026-09-06. Conferido com `git check-ignore -v`.
__pycache__/
