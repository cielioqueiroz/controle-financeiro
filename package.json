{
  "name": "capital-financeiro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "preview": "npm run preview --workspace frontend",
    "test": "npm run test --workspace frontend",
    "test:watch": "npm run test:watch --workspace frontend",
    "lint": "oxlint --deny-warnings",
    "verificar": "uv run --with playwright python scripts/verificar.py",
    "verificar:rapido": "uv run python scripts/verificar.py --rapido",
    "caminhos": "uv run python scripts/checar-caminhos.py",
    "build:semlogin": "npm run build --workspace frontend -- --mode semlogin",
    "medir:pdf": "uv run --with playwright python scripts/medir-pdf.py",
    "medir:a11y": "uv run --with playwright python scripts/medir-a11y.py",
    "medir:peso": "uv run python scripts/medir-peso.py",
    "fixtures": "tsx scripts/gerar-fixtures.ts",
    "build:login": "npm run build --workspace frontend -- --mode login",
    "medir:login": "uv run --with playwright python scripts/medir-login.py"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "@better-auth/api-key": "1.6.23",
    "@better-auth/core": "1.6.23",
    "@daveyplate/better-auth-ui": {
      "@better-auth/api-key": "1.6.23",
      "@better-auth/core": "1.6.23"
    }
  }
}
