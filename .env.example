# Supabase — copie para .env e preencha com as chaves do SEU projeto.
# Onde achar: painel do Supabase → Project Settings → API.
# Ver docs/SETUP-SUPABASE.md para o passo a passo completo.
#
# O app FUNCIONA sem estas chaves (modo "importa e vê"). A persistência
# (salvar, puxar por período, login) só liga quando elas estão presentes.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
